# Local monorepo ports (do not collide with Yuasa / eforte)
WEB_PORT=7000
API_PORT=7001
API_PROXY_URL=http://localhost:7001
NEXT_PUBLIC_APP_URL=http://localhost:7000

# VRA local Supabase (sibling ../vra-supabase)
# Ports: API 54341, DB 54342, Studio 54343, Mailpit 54344
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BUCKET_NAME=vra

# Postgres (from `supabase status` after start)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# Admin panel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Member auth salts (optional overrides)
# MEMBER_PASSWORD_SALT=
# MEMBER_SESSION_SALT=

# SMTP / membership emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

MEMBERSHIP_ADMIN_EMAIL=
MEMBERSHIP_BANK_NAME=
MEMBERSHIP_BANK_IBAN=
MEMBERSHIP_BANK_BIC=
MEMBERSHIP_PAYMENT_REFERENCE_PREFIX=Membership fee
MEMBERSHIP_CONTACT_EMAIL=
