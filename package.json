{
  "name": "vra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter @vra/db build && pnpm --filter api build && pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "db:generate": "pnpm --filter @vra/db prisma:generate",
    "db:push": "pnpm --filter @vra/db prisma:db:push",
    "db:seed": "pnpm --filter @vra/db prisma:db:seed",
    "db:studio": "pnpm --filter @vra/db prisma:studio",
    "supabase:start": "cd ../vra-supabase && supabase start",
    "supabase:stop": "cd ../vra-supabase && supabase stop",
    "supabase:status": "cd ../vra-supabase && supabase status"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
